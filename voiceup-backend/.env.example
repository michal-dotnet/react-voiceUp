# Copy to .env for local development: cp .env.example .env
# Never commit .env or real secrets.

# development | test | production
NODE_ENV=development

PORT=3000

# debug | info | warn | error | silent
# Default when omitted: debug (development), info (production), silent (test)
LOG_LEVEL=debug

# PostgreSQL connection string (required).
DATABASE_URL=postgresql://voiceup:voiceup@localhost:5432/voiceup_dev

# Secret for signing access tokens (required, at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars

# Access token lifetime in seconds (default 7200 = 2 hours). There are no refresh tokens.
JWT_EXPIRES_IN_SECONDS=7200

# Comma-separated list of browser origins allowed by CORS.
# Leave empty to disallow all cross-origin browser requests.
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IP detection (0 = none).
# Set to 1 when running behind a single proxy/load balancer so rate limiting sees real client IPs.
TRUST_PROXY=0

# Global API rate limit: max requests per client IP per window (the health checks are exempt).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Register/login attempts per IP per window.
AUTH_RATE_LIMIT_MAX=20
# Issue creations and uploads per IP per hour.
WRITE_RATE_LIMIT_MAX=30

# Guest ("this affects me too" without login) requests per IP per hour.
GUEST_CONFIRM_RATE_LIMIT_MAX=20
# Max guest confirmations from one IP on one issue (allows a few people behind one network).
GUEST_CONFIRMATIONS_PER_IP=3

# Used by `npm run db:seed` only: the first admin account.
SEED_ADMIN_EMAIL=admin@voiceup.local
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_ADMIN_NAME=VoiceUp Admin

# Used by the test suite only. The database name must end with "_test"; it is wiped on every run.
DATABASE_URL_TEST=postgresql://voiceup:voiceup@localhost:5432/voiceup_test
